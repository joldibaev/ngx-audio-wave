{
  "name": "ngx-audio-wave-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run library:build && ng build",
    "github:build": "npm run library:build && ng build --configuration github-pages",
    "github:deploy": "npx angular-cli-ghpages --dir=dist/ngx-audio-wave-app/browser --no-silent",
    "watch": "ng build --watch --configuration development",
    "test": "ng test ngx-audio-wave",
    "serve:ssr:ngx-audio-wave-app": "node dist/ngx-audio-wave-app/server/server.mjs",
    "library:prepare": "cp README.md projects/ngx-audio-wave/README.md",
    "library:build": "npm run library:prepare && ng build ngx-audio-wave",
    "library:watch": "ng build ngx-audio-wave --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.1",
    "@angular/common": "^22.0.1",
    "@angular/compiler": "^22.0.1",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/platform-browser": "^22.0.1",
    "@angular/platform-browser-dynamic": "^22.0.1",
    "@angular/platform-server": "^22.0.1",
    "@angular/router": "^22.0.1",
    "@angular/ssr": "^22.0.1",
    "express": "^4.18.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.1",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/express": "^4.17.17",
    "@types/node": "^24.13.2",
    "angular-estree-parser": "^15.5.0",
    "jsdom": "^29.1.1",
    "ng-packagr": "^22.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8"
  }
}
